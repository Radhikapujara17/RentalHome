# ==============================================================================
# Git Ignore Configuration for RentNest Full-Stack Workspace
# ==============================================================================

# Dependencies (Prevents 10,000+ files from being tracked)
node_modules/
*/node_modules/
server/node_modules/
client/node_modules/

# Production Build Outputs
dist/
client/dist/
build/
out/

# Environment Variables & Secrets (Keep your API keys safe)
.env
.env.local
.env.*.local
server/.env
client/.env
*.pem

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/
