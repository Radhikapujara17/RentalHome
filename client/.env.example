# ==============================================================================
# RentNest Frontend Environment Configuration
# Step-by-step instructions for getting every key: See PLAN.md (Section 11)
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# WebSocket Server Base URL
VITE_SOCKET_URL=http://localhost:5000

# Default City & Coordinates (Rajkot, Gujarat)
VITE_DEFAULT_CITY=Rajkot
VITE_DEFAULT_LAT=22.3039
VITE_DEFAULT_LNG=70.8022

# Optional Google Maps API Key (Section 11.6 in PLAN.md)
# Default is 100% free OpenStreetMap & Leaflet (Zero API key needed)
# VITE_GOOGLE_MAPS_API_KEY=AIzaSyD-YourOptionalGoogleMapsKey
