# ==============================================================================
# RentNest Backend Environment Configuration
# Step-by-step instructions for getting every key: See PLAN.md (Section 11)
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# 1. MongoDB Database (Section 11.1 in PLAN.md)
# Local: mongodb://127.0.0.1:27017/rentnest
# Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rentnest?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rentnest

# 2. JWT Secrets (Section 11.2 in PLAN.md - generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES=30d

# 3. Development OTP Bypass (Section 11.4 in PLAN.md)
# Set to false once real Twilio credentials are provided
USE_DEV_OTP=true
DEV_OTP_CODE=123456

# 4. Cloudinary Image Storage (Section 11.3 in PLAN.md - https://cloudinary.com/console)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=rentnest_production

# 5. Twilio SMS & WhatsApp (Section 11.4 in PLAN.md - https://console.twilio.com)
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+14155238886
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 6. Transactional Email (Section 11.5 in PLAN.md - Resend or Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
# EMAIL_FROM="RentNest Team <no-reply@rentnest.in>"
